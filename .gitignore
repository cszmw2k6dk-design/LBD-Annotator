yolo26/*.part

# 客户图纸/标注数据：绝不入库（补标建议里是原图 + 标注，2.3 GB）
yolo26/补标建议/
yolo26/补标结果/
# 补标交付打包（里面是原图 + 标注的 zip），同样不入库
补标打包/

# 备份目录和打包临时目录（含 exe、poppler 等二进制）
backup/
build_tmp/

# 系统生成的缩略图缓存
Thumbs.db
desktop.ini
